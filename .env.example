# Stripe
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_secret_key_here

# Contact form email (SMTP)
# For Gmail: use an App Password (myaccount.google.com/apppasswords)
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
# For other providers: set values accordingly
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_sending_address@gmail.com
SMTP_PASS=your_app_password_here
CONTACT_TO_EMAIL=your_receiving_address@gmail.com

# Resend (mailing list + welcome email)
# Sign up at https://resend.com — free tier: 3,000 emails/month
# 1. Verify your domain (alchemyoliver.com) under Domains in the Resend dashboard
# 2. Create an Audience under the Audiences tab, copy its ID below
# 3. Create an API key under API Keys, copy it below
RESEND_API_KEY=re_your_api_key_here
RESEND_AUDIENCE_ID=your_audience_id_here
# The "from" address must use your verified domain
RESEND_FROM_EMAIL=Alchemy Oliver <hello@alchemyoliver.com>
